    "applemusic.auth.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app integrates with Apple Music to provide music previews."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは音楽プレビューを提供するためにApple Musicと統合されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 음악 미리듣기를 제공하기 위해 Apple Music과 통합됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此應用程式整合 Apple Music 以提供音樂預覽功能。"
          }
        }
      }
    },
