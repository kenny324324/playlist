    "applemusic.auth.reason" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Spotify preview is not available, we will use Apple Music as a backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotifyのプレビューが利用できない場合、Apple Musicをバックアップとして使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify 미리듣기를 사용할 수 없을 때 Apple Music을 백업으로 사용합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 Spotify 預覽不可用時，我們將使用 Apple Music 作為備援。"
          }
        }
      }
